{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git remote -v)",
      "Bash(git config --get:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git ls-files:*)",
      "PowerShell(git check-ignore:*)",
      "PowerShell(git remote -v)",
      "PowerShell(git config --get:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)"
    ],
    "deny": [
      "Read(./private/**)",
      "Edit(./private/**)",
      "Read(./**/.env*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)"
    ]
  }
}
